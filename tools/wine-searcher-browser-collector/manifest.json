{
  "manifest_version": 3,
  "name": "Where is Kelley Merchant Collector",
  "version": "1.0.0",
  "description": "Collects public Wine-Searcher merchant profiles through a user-controlled Chrome session.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://www.wine-searcher.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Where is Kelley collector"
  }
}
