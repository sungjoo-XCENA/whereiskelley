[Unit]
Description=Where is Kelley biweekly wine-list collection
After=network-online.target whereiskelley.service
Wants=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/whereiskelley
EnvironmentFile=-/home/opc/whereiskelley/.env.local
ExecStart=/home/opc/whereiskelley/scripts/weekly-oracle-collection.sh
Nice=10

[Install]
WantedBy=multi-user.target
