[Unit]
Description=Where is Kelley biweekly wine-shop inventory refresh
After=network-online.target whereiskelley.service
Wants=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/whereiskelley
EnvironmentFile=-/home/opc/whereiskelley/.env.local
ExecStart=/usr/bin/bash /home/opc/whereiskelley/scripts/biweekly-shop-inventory.sh
Nice=10

[Install]
WantedBy=multi-user.target
